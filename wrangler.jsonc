{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swing-desk",
  "main": "worker.ts",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "keep_vars": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
